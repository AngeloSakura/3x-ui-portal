# 生产使用 HTTPS 反向代理，后端默认只监听回环。
PORTAL_LISTEN=127.0.0.1:8090
# 登录站点和主用订阅都使用此公开地址；也可填公网 IP，但必须配备可信的匹配 HTTPS 证书。
PORTAL_ORIGIN=https://portal.example.com
PORTAL_DATA_DIR=./data
PORTAL_KEY_FILE=./secrets/master.key
PORTAL_WEB_DIR=./frontend/dist

# managed: 内置 HTTPS，可公开监听；proxy: 由外部 HTTPS 代理终止 TLS。
PORTAL_TLS_MODE=proxy
PORTAL_ACME_LISTEN=0.0.0.0:80
GOMEMLIMIT=40MiB
